  </div>
</div>

<div class="sheet" data-sheet="1" hidden>
  <div class="sheet-ui" data-ui aria-label="CatchIt favoriler ekranı">
    <div class="top"><strong>Favoriler</strong><span class="ui-small">4 işletme</span></div>
