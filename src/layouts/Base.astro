---
import '../styles/global.css';
import '../styles/ui.css';
import { SITE, abs } from '../config/site';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  /** Bu sayfanın temiz Markdown sürümü (ajanlar için). */
  markdownPath: string;
  jsonLd?: object;
  ogType?: 'website' | 'article';
  /** Sayfada kullanılan fotoğraflar; footer'daki kaynak satırı için. */
  photos?: string[];
  /** Üst çubuk: kahraman sayfalarında dev kelime zaten markayı taşır. */
  bar?: boolean;
}

const { title, description, path, markdownPath, jsonLd, ogType = 'website', photos = [], bar = false } = Astro.props;
const canonical = abs(path);
const ogImage = abs('/og.jpg');
---

<!doctype html>
<html lang={SITE.lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js')</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="theme-color" content="#eef1ec" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=clash-grotesk@400,500&display=swap" rel="stylesheet" />

    <!-- AI ajanları için düşük token maliyetli sürümler -->
    <link rel="alternate" type="text/markdown" href={markdownPath} title="Markdown" />
    <link rel="help" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">İçeriğe geç</a>
    {bar && (
      <header class="bar">
        <a class="wordmark-small" href="/" aria-label={`${SITE.name} ana sayfa`}>catchit</a>
        <nav class="nav" aria-label="Ana menü">
          <ul>
            <li><a class="link" href="/">Uygulama</a></li>
            <li><a class="link" href="/merchants">İşletmeler</a></li>
          </ul>
          <a class="nav-action link" href="/#indir">Uygulamayı indir</a>
        </nav>
      </header>
    )}
    <main id="main">
      <slot />
    </main>
    <Footer markdownPath={markdownPath} photos={photos} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
